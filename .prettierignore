legacy/

# Prose and specifications. Prettier pads markdown tables to align columns,
# which produces very large diffs on documents that are edited by hand and read
# as raw text. Code formatting is enforced; prose formatting is not.
docs/
*.md

# Generated output.
packages/ui/dist/
pnpm-lock.yaml

# dbt build output. Generated by `pnpm dbt:build` and gitignored; formatting a
# manifest nobody reads costs time and produces a diff nobody wants.
data/dbt/target/
data/dbt/logs/
data/dbt/dbt_packages/

# Detector golden fixtures. Written by the test suite itself
# (FITOS_REGENERATE_GOLDEN=1), so a formatter and a generator would fight: every
# regeneration would produce a prettier-dirty file and every format would produce
# a diff the generator undoes.
services/worker/tests/golden/

# The gap lifecycle contract. Generated by
# services/api/tools/export_gap_lifecycle.py, and a Python test asserts the
# committed bytes match what the exporter produces — so a formatter rewriting
# it would fail that test on the next run. Same reasoning as the golden
# fixtures above: a generator and a formatter cannot both own a file.
packages/contracts/src/gap-lifecycle.json
