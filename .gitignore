# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.venv/
__pycache__/
*.py[cod]

# build output
.next/
.vinext/
.turbo/
out/
dist/
build/dist/
*.tsbuildinfo
next-env.d.ts

# local runtime state
.wrangler/
.pytest_cache/
.ruff_cache/
.mypy_cache/
coverage/
htmlcov/
.data/

# env and secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# os / editor
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Cube writes its RocksDB state into the mounted conf directory at runtime.
# It is a container's working data, not source, and it was committed by an
# over-broad `git add` the first time Compose was started.
services/semantic/.cubestore/
